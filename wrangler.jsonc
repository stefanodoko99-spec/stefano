{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker for the whole site: the static build in dist/ plus worker/ (settings in
  // every page, the admin panel's API, the telegram inbox, the portrait).
  "name": "sdesign",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // the Worker sees every request first, so pages leave with the admin's settings in them
    "run_worker_first": true
  },
  // Settings, the portrait and the telegrams. `npm run worker:dev` simulates this in
  // .wrangler/state. Before the first deploy: npx wrangler kv namespace create SITE,
  // and put the id it prints here (it is not a secret).
  "kv_namespaces": [{ "binding": "SITE", "id": "63d22783535a425b950aec5c19db4e62" }],
  // Secrets, never in this file: SESSION_SECRET and ADMIN_PASSWORD_HASH
  // (npx wrangler secret put ...; locally they live in .dev.vars, which git ignores).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
